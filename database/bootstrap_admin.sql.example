-- MWH Local first admin bootstrap.
-- Generate a password hash on the server:
-- php -r "echo password_hash('YOUR_ADMIN_PASSWORD', PASSWORD_DEFAULT), PHP_EOL;"
--
-- Replace the placeholder hash below. Do NOT commit a real password or hash
-- that is intended to remain secret.
--
-- Run against the dedicated sywwzxsv_mwh_local database after schema.sql.

INSERT INTO local_admin_users (role_id,name,email,password_hash,status)
SELECT id,'MWH Local Super Admin','YOUR_ADMIN_EMAIL','PASTE_PASSWORD_HASH_HERE','active'
FROM local_admin_roles
WHERE name='super_admin'
LIMIT 1;
